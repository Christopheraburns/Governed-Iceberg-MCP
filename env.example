# Governed Iceberg MCP: every setting, with placeholders. Set these as the Workbench application's
# environment variables (Project Settings > Advanced, or per application). Nothing is read from a file.

# ── Who is calling ─────────────────────────────────────────────────────────────────────────────────
AUTH_MODE=knox                               # knox (verify KNOXTOKEN offline) | development (trust DEV_USER; local tests only)
KNOX_JWKS_URL=https://<knox-host>:8443/gateway/<token-topology>/knoxtoken/api/v1/jwks.json
# KNOX_JWKS_FILE=/home/cdsw/knox-jwks.json  # alternative for air-gapped hosts: a saved copy of the JWKS
KNOX_ISS=KNOXSSO                             # knox.token.issuer (default KNOXSSO)
KNOX_AUD=                                    # knox.token.audiences of the topology; empty skips the audience check
KNOX_TOKEN_URL=https://<knox-host>:8443/gateway/<token-topology>/knoxtoken/api/v2/token   # advertised to MCP clients
# DEV_USER=analyst1                          # development mode only

# ── Impala (CDW virtual warehouse) ─────────────────────────────────────────────────────────────────
IMPALA_HOST=coordinator-<vw>.<env>.example.com
IMPALA_PORT=443
IMPALA_DATABASE=default
IMPALA_AUTH_MECHANISM=GSSAPI                 # GSSAPI (proxy keytab + doAs) | LDAP (IMPALA_USER/IMPALA_PASSWORD; dev only)
IMPALA_SVC_NAME=hive                         # the VW's SPN service name
KRB_FQDN=<vw-spn-host>                       # the VW's SPN host from `cdp dw describe-vw` (kerberosImpalaShell); not the connect host
IMPALA_HTTP_PATH=cliservice                  # doAs=<user> is appended per request
IMPALA_USE_SSL=true
# IMPALA_CA_CERT=/home/cdsw/ca.pem
IMPALA_TIMEOUT=60
IMPALA_IMPERSONATE=true                      # false runs everything as the proxy account itself (no per-user Ranger policy)

# ── Kerberos proxy identity (the "may impersonate" credential; never an end user's) ────────────────
MCP_KEYTAB=/home/cdsw/.keytabs/mcpclient.keytab
MCP_PRINC=mcpclient@EXAMPLE.REALM            # its short name must be in the VW's --authorized_proxy_user_config
KINIT_INTERVAL_SECONDS=21600
MCP_STATE_DIR=/home/cdsw/.governed-mcp          # shared project-storage state for the MCP and management apps

# ── Serving ────────────────────────────────────────────────────────────────────────────────────────
# CDSW_APP_PORT is set by Workbench; MCP_PORT (default 8772) is used when running outside Workbench
MCP_BIND=127.0.0.1
MCP_PUBLIC_URL=https://<application-subdomain>.<workbench-domain>
QUERY_DEFAULT_LIMIT=500
QUERY_MAX_LIMIT=5000

# ── Management application (set on the management application only) ─────────────────────────────
# Workbench authentication should remain enabled for this application.
MANAGEMENT_ADMIN_USERS=                              # optional comma-separated users allowed to operate the service
# MANAGEMENT_ALLOW_LOCAL=true                         # local development only
